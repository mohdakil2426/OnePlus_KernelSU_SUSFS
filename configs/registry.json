{
  "kernel_source": "https://github.com/HELLBOY017/kernel_oneplus_sm8250.git",
  "kernel_repo": "HELLBOY017/kernel_oneplus_sm8250",
  "soc": "sm8250",
  "soc_codename": "kona",
  "default_branch": "14",
  "default_defconfig": "vendor/oplus-stock_defconfig",
  "susfs_default_branch": "kernel-4.19",
  "ksun_default_ref": "next",
  "devices": {
    "OP8": {
      "name": "OnePlus 8",
      "codenames": ["instantnoodle"],
      "models": ["IN2010", "IN2011", "IN2013", "IN2015", "IN2017", "IN2019"]
    },
    "OP8Pro": {
      "name": "OnePlus 8 Pro",
      "codenames": ["instantnoodlep"],
      "models": ["IN2020", "IN2021", "IN2023", "IN2025"]
    },
    "OP8T": {
      "name": "OnePlus 8T",
      "codenames": ["kebab", "lemonkebab"],
      "models": ["KB2000", "KB2001", "KB2003", "KB2005", "KB2007"]
    },
    "OP9R": {
      "name": "OnePlus 9R",
      "codenames": ["lemonades", "lemonade"],
      "models": ["LE2100", "LE2101"]
    }
  },
  "known_branches": {
    "14": {
      "android": 14,
      "os_label": "A14-class / stock-oriented CLO",
      "devices": ["OP8", "OP8Pro", "OP8T", "OP9R"],
      "defconfig": "vendor/oplus-stock_defconfig",
      "notes": "Default and recommended for this builder (STOCK verified)."
    },
    "13.1": {
      "android": 13,
      "os_label": "A13.1-class",
      "devices": ["OP8", "OP8Pro", "OP8T", "OP9R"],
      "defconfig": "vendor/oplus-stock_defconfig",
      "notes": "Selectable in workflow (kernel_branch=13.1). Prefer for stock OOS 13 / 13.1-era phones."
    },
    "oos": {
      "android": null,
      "os_label": "Older OOS-oriented",
      "devices": ["OP8", "OP8Pro", "OP8T", "OP9R"],
      "notes": "Optional; verify defconfig on tree before use."
    }
  },
  "build_modes": {
    "STOCK": {
      "description": "Non-root baseline (no KernelSU, no SUSFS)",
      "ksun": false,
      "susfs": false
    },
    "KSUN": {
      "description": "KernelSU-Next only (built-in non-GKI driver)",
      "ksun": true,
      "susfs": false
    },
    "KSUN_SUSFS": {
      "description": "KernelSU-Next + SUSFS (kernel-4.19 patches)",
      "ksun": true,
      "susfs": true
    }
  }
}
